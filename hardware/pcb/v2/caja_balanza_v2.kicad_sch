(text "TPS63020: VIN 1.8–5.5 V. With the scale charger connected, BAT must stay < 5.5 V." (exclude_from_sim no) (at 15.24 71.12 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "7627e6bd-55bf-50f1-8710-316b18deca8e"))
