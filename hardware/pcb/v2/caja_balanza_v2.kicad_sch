(text "D3 (Schottky, band toward the ESP) keeps the" (exclude_from_sim no) (at 198.12 148.59 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "d39df6ad-2c79-5739-a081-c01b0e0507e8"))
