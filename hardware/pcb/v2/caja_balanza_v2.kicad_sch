(text "GPIO1 = SL, GPIO4 = DA (bus read only)." (exclude_from_sim no) (at 163.83 68.58 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "8d38bf07-f630-5672-9938-1a1e52acfb3e"))
