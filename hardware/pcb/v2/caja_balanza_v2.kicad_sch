(text "Powered through 3V3 only; the 5V pin is not connected." (exclude_from_sim no) (at 163.83 76.2 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "f922f902-4c7d-5585-ba1a-73df676fdc55"))
